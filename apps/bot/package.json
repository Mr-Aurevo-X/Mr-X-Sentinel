{
  "name": "@sentinel/bot",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/shard.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test": "../../packages/shared/node_modules/.bin/vitest run --config ../../packages/shared/vitest.config.ts"
  },
  "dependencies": {
    "@sentinel/core": "workspace:*",
    "@sentinel/database": "workspace:*",
    "@sentinel/shared": "workspace:*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "i18next": "^24.2.0",
    "kazagumo": "^3.4.3",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
