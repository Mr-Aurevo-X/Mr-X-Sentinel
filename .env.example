# Mr-X Sentinel — copy to .env (never commit .env)

DISCORD_TOKEN=
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=
BOT_OWNER_ID=YOUR_DISCORD_USER_ID
# SHARD_COUNT=   # laisser commenté sauf gros bot multi-shards

DATABASE_URL=postgresql://mrx:mrx@localhost:5433/sentinel
REDIS_URL=redis://localhost:6379

NEXTAUTH_SECRET=change-me-to-random-32-chars-min
NEXTAUTH_URL=http://localhost:3000

LOG_LEVEL=info

# Optionnel — bannière sur /sentinel menu et /help
# BRAND_BANNER_URL=https://example.com/sentinel-banner.png

# IA + Brain sont parkés dans archive/ai-brain/

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace-with-strong-lavalink-password
