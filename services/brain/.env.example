# Clé API requise dans tous les appels (header X-Api-Key)
# Hors DEV=1, une clé faible/absente empêche le démarrage.
BRAIN_API_KEY=replace-with-strong-random-key

# Bind local only by default (start.py)
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8765

# DEV=1 autorise une clé faible en local uniquement
# DEV=1
